<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Viagem.Views.ViagemPage"
             xmlns:viewModels="clr-namespace:Viagem.ViewModel"
             xmlns:models="clr-namespace:Viagem.Models"
             x:DataType="viewModels:ViagemViewModel"
             BackgroundColor="#FFF"
             Shell.NavBarIsVisible="False"
             Title="ViagemPage">
    <Grid RowDefinitions="* , Auto, Auto" Padding="5,10">
        <CarouselView Grid.Row="0"
                      IndicatorView="Indicador"
                      Position="{Binding Posicao}"
                      Loop="False"
                      ItemsSource="{Binding Viagens}">

            <CarouselView.ItemTemplate>
                <DataTemplate x:DataType="models:ViagemItem">
                    <VerticalStackLayout VerticalOptions="Center"
                                         Spacing="20">

                        <Image Source="{Binding ImageUrl}"
                               HeightRequest="300"/>

                        <Label Text="{Binding Titulo}"
                               FontSize="32"
                               TextColor="#000000"
                               HorizontalTextAlignment="Center"
                               FontAttributes="Bold"/>

                        <Label Text="{Binding Descricao}"
                                FontSize="16"
                                TextColor="#000000"
                                HorizontalTextAlignment="Center"
                                />
                    </VerticalStackLayout>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <IndicatorView x:Name="Indicador"
                Grid.Row="1"
                IndicatorSize="14"
                HorizontalOptions="Center"
                IndicatorColor="#FFE3ED"
                SelectedIndicatorColor="#FF1568"/>

        <Grid 
     Grid.Row ="2"
     ColumnDefinitions="*,*"
     ColumnSpacing="15">

            <Button Grid.Column="0"
             Text="Get started"
             BackgroundColor="#FF1568"/>

            <Button Grid.Column="1"
             Command="{Binding ProximoCommand}"
             Text="Next"
             BackgroundColor="#4EA717"
             IsVisible="{Binding ExibirBotao}"/>
        </Grid>

    </Grid>
</ContentPage>